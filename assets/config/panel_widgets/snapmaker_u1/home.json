{
  "_comment": "The U1's 480x320 panel starts with print state and heater metrics. Keep the compact view quiet; the widget catalog keeps optional detail available for personal layouts.",
  "anchors": [
    {
      "id": "print_status",
      "placements": {
        "micro": { "col": 0, "row": 0, "colspan": 12, "rowspan": 4 },
        "tiny": { "col": 0, "row": 0, "colspan": 10, "rowspan": 4 },
        "micro@8x6": { "col": 0, "row": 0, "colspan": 8, "rowspan": 4 }
      }
    },
    {
      "id": "temperature",
      "placements": {
        "micro": { "col": 0, "row": 4, "colspan": 6, "rowspan": 4 },
        "tiny": { "col": 0, "row": 4, "colspan": 5, "rowspan": 4 },
        "micro@8x6": { "col": 0, "row": 4, "colspan": 4, "rowspan": 2 }
      }
    },
    {
      "id": "bed_temperature",
      "placements": {
        "micro": { "col": 6, "row": 4, "colspan": 6, "rowspan": 4 },
        "tiny": { "col": 5, "row": 4, "colspan": 5, "rowspan": 4 },
        "micro@8x6": { "col": 4, "row": 4, "colspan": 4, "rowspan": 2 }
      }
    }
  ],
  "disabled": {
    "micro": ["printer_image", "fan_stack", "temp_graph", "tips"],
    "tiny": ["printer_image", "fan_stack", "temp_graph", "tips"]
  }
}
